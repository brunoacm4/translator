# ── Translator configuration ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# .env is gitignored — never commit real credentials or IPs.

# Slice Manager
SM_BASE_URL=http://localhost:8080       # Use real SM IP when VPN is active
SM_TIMEOUT=15.0                         # Under the NEF's 25 s limit (CONSIDERATIONS §4.6)
SM_HEALTH_TIMEOUT=5.0

# Logging
LOG_LEVEL=INFO                          # DEBUG for verbose local development
LOG_JSON=true                           # false for human-readable local output

# Circuit Breaker
CB_FAILURE_THRESHOLD=5                  # Open circuit after 5 consecutive failures
CB_RECOVERY_TIMEOUT=30.0               # Probe SM again after 30s

# Retry
RETRY_MAX_ATTEMPTS=1                    # 1 = no retry (default, CONSIDERATIONS §4.6)
RETRY_MIN_WAIT=0.5
RETRY_MAX_WAIT=3.0

# SM async operation polling
# Enabled by default: the Slice Manager implements GET /operations/{request_id}
# since Sept 2026, so each operation is followed until completed/failed and the
# NEF callback fires. Set to false against an older SM (that endpoint returns
# 500 there); the synchronous 202 is then treated as the terminal result.
SM_POLLING_ENABLED=true

# SQLite state
TRANSLATOR_DB_PATH=./translator.db
